# AnyRouter / AgentRouter 账号配置
#
# 每个账号二选一：
#   1) username + password —— 【推荐】每次运行自动登录换新会话，不必再维护 cookies
#      - anyrouter  ：登录换 session 后再调签到接口
#      - agentrouter：登录动作本身就是签到
#      - username 可填用户名或邮箱；OAuth 注册的账号走「忘记密码」重置后即可用
#      - 此时 "api_user" 可省略，脚本会从登录响应里的用户 ID 自动推断
#   2) cookies            —— 旧方式，有效期有限、会频繁过期，届时要重新获取
#      - 走这种方式时 "api_user" 必需
#   两种都给也可以：cookies 用于算签到收益，并在登录失败时降级兜底
#
# 两种都给也可以：cookies 用于查询签到前余额，从而算出本次签到收益。
# 不提供 cookies 时仍能正常签到，只是通知里只显示签到状态与当前余额。

# 推荐写法：两个平台都只用用户名密码（api_user 可省略，脚本从登录响应自动推断）
ANYROUTER_ACCOUNTS=[{"name":"AnyRouter","username":"你的用户名或邮箱","password":"你的密码"},{"name":"AgentRouter","provider":"agentrouter","username":"你的用户名或邮箱","password":"你的密码"}]

# 旧写法：用浏览器 cookies（有效期有限、会过期），此时 api_user 必需
# ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# CUSTOM_SMTP_SERVER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
